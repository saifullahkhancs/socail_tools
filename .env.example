# ===================================================
# Social Media Scheduler - Environment Configuration
# ===================================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# Database (SQLite - no changes needed)
DATABASE_URL="file:./dev.db"

# App URL (change if not running on port 3000)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ===================================================
# YOUTUBE (Google Cloud Console)
# ===================================================
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project
# 3. Enable "YouTube Data API v3"
# 4. Create OAuth 2.0 credentials (Web Application)
# 5. Add http://localhost:3000/api/platforms/youtube/callback to redirect URIs
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI="http://localhost:3000/api/platforms/youtube/callback"

# ===================================================
# INSTAGRAM REELS (Meta for Developers)
# ===================================================
# 1. Go to https://developers.facebook.com/
# 2. Create a new app (Business type)
# 3. Add Instagram Graph API product
# 4. Add http://localhost:3000/api/platforms/instagram/callback to redirect URIs
# 5. You NEED an Instagram Business or Creator account
# NOTE: Instagram requires videos to be publicly accessible.
#       Use ngrok for local testing: ngrok http 3000
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_REDIRECT_URI="http://localhost:3000/api/platforms/instagram/callback"
# When using ngrok, set this to your ngrok URL for Instagram video uploads:
# NEXT_PUBLIC_APP_URL="https://your-ngrok-url.ngrok.io"

# ===================================================
# TIKTOK (TikTok for Developers)
# ===================================================
# 1. Go to https://developers.tiktok.com/
# 2. Create an app
# 3. Request "Content Posting API" access (requires review)
# 4. Add http://localhost:3000/api/platforms/tiktok/callback to redirect URIs
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:3000/api/platforms/tiktok/callback"
